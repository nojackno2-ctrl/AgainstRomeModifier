# Against Rome Modifier editor settings.
# Product code is Rust (rustfmt defaults: 4-space indent); this file only keeps generic rules.

root = true

[*]
end_of_line = crlf
insert_final_newline = true

[*.rs]
indent_style = space
indent_size = 4

[*.{toml,json,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.{ps1,psm1}]
indent_style = space
indent_size = 4
