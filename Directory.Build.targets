<Project>
  <!-- Rust is built explicitly with tools/build-native-data.ps1. Deploy the
       verified local DLL beside managed hosts and into publish outputs. -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <NativeDataDll Condition="'$(NativeDataDll)' == ''">$(MSBuildThisFileDirectory)re_workspace/native-data-deploy/against_rome_data.dll</NativeDataDll>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' and Exists('$(NativeDataDll)')">
    <None Include="$(NativeDataDll)" Link="against_rome_data.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireNativeDataForModifierPublish" BeforeTargets="PrepareForPublish"
          Condition="'$(MSBuildProjectName)' == 'AgainstRomeModifier' and !Exists('$(NativeDataDll)')">
    <Error Text="Rust native data DLL is required for publishing. Run tools/build-native-data.ps1 first, or set NativeDataDll to a verified against_rome_data.dll." />
  </Target>
</Project>
