<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Allows NuGet restore on Linux-based dependency-submission runners. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>AgainstRomeModifier.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AgainstRomeModifier.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="re_workspace\**" />
    <Compile Remove="scratch\**" />
    <Compile Remove="tests\**" />
    <EmbeddedResource Include="Backup.zip" Condition="'$(IncludeBackupZip)' != 'false' and Exists('Backup.zip')" />
    <EmbeddedResource Include="TechDoc.md" LogicalName="TechDoc.md" />
    <EmbeddedResource Include="TechDoc_EN.md" LogicalName="TechDoc_EN.md" />
    <EmbeddedResource Include="ThirdParty\dgVoodoo2\D3D8.dll" LogicalName="dgVoodoo2.D3D8.dll" />
    <EmbeddedResource Include="ThirdParty\dgVoodoo2\DDraw.dll" LogicalName="dgVoodoo2.DDraw.dll" />
    <EmbeddedResource Include="ThirdParty\dgVoodoo2\dgVoodooCpl.exe" LogicalName="dgVoodoo2.dgVoodooCpl.exe" />
    <EmbeddedResource Include="ThirdParty\dgVoodoo2\dgVoodoo.conf" LogicalName="dgVoodoo2.dgVoodoo.conf" />
  </ItemGroup>
</Project>
